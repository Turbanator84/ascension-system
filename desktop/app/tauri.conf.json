{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ascension System",
  "version": "0.1.0",
  "identifier": "io.github.turbanator84.ascension",
  "build": {
    "frontendDist": "dist",
    "beforeDevCommand": "cargo run -q -p xtask -- frontend",
    "beforeBuildCommand": "cargo run -q -p xtask -- frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ascension System",
        "width": 480,
        "height": 900,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Leveling-system tracker for habits, training, nutrition and school",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
